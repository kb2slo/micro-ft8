{
  "config": {
    "MY_CALLSIGN": "AG6AQ",
    "MY_GRID": "CM97",
    "DX_CALLSIGN": "N6HAN",
    "DX_GRID": "CM87",
    "TX_ON_EVEN": true,
    "TRIES": 3
  },
  "comment": "The CQ's life in the queue: (1) it stays queued with its tries, waiting for its own parity; (2) dropping it (the CQ row's x) stops it at once; (3) Call CQ starts a fresh one; (4) a QSO goes before it; (5) after the QSO it resumes where it was, since an answer gives none back, and it ends at its count.",
  "periods": [
    {
      "comment": "Period 0 (even): Call CQ with 5 tries. CQ 1 of 5.",
      "messages": [],
      "cq_call": {
        "time_offset": 0.0,
        "tries": 5
      },
      "expect": {
        "tx": "CQ AG6AQ CM97"
      }
    },
    {
      "comment": "Period 1 (odd): the CQ stays queued and waits for even.",
      "messages": [],
      "expect": {
        "tx": ""
      }
    },
    {
      "comment": "Period 2 (even): the same CQ again, 2 of 5.",
      "messages": [],
      "expect": {
        "tx": "CQ AG6AQ CM97"
      }
    },
    {
      "comment": "Period 3 (odd): drop the CQ (its x).",
      "messages": [],
      "cq_drop": {
        "time_offset": 0.0
      },
      "expect": {
        "tx": ""
      }
    },
    {
      "comment": "Period 4 (even): no CQ: it was dropped.",
      "messages": [],
      "expect": {
        "tx": ""
      }
    },
    {
      "comment": "Period 5 (odd): still nothing queued.",
      "messages": [],
      "expect": {
        "tx": ""
      }
    },
    {
      "comment": "Period 6 (even): Call CQ again: a fresh CQ, 1 of 5.",
      "messages": [],
      "cq_call": {
        "time_offset": 0.0,
        "tries": 5
      },
      "expect": {
        "tx": "CQ AG6AQ CM97"
      }
    },
    {
      "comment": "Period 7 (odd): DX answers with a grid. Its QSO goes before the CQ.",
      "messages": [
        {
          "call_to": "${MY_CALLSIGN}",
          "call_from": "${DX_CALLSIGN}",
          "locator": "${DX_GRID}",
          "snr": -5,
          "slot": 1,
          "freq_hz": 1200
        }
      ],
      "expect": {
        "tx": "N6HAN AG6AQ -5"
      }
    },
    {
      "comment": "Period 8 (even): the report again, not the CQ.",
      "messages": [],
      "expect": {
        "tx": "N6HAN AG6AQ -5"
      }
    },
    {
      "comment": "Period 9 (odd): DX sends R-12: RR73, which logs.",
      "messages": [
        {
          "call_to": "${MY_CALLSIGN}",
          "call_from": "${DX_CALLSIGN}",
          "locator": "R-12",
          "snr": -12,
          "slot": 1,
          "freq_hz": 1200
        }
      ],
      "expect": {
        "tx": "N6HAN AG6AQ RR73",
        "log": "N6HAN CM87 rst_sent=-5 rst_rcvd=-12"
      }
    },
    {
      "comment": "Period 10 (even): RR73 went out once and the entry parked. The CQ resumes: 2 of 5, the answer gave none back.",
      "messages": [],
      "expect": {
        "tx": "CQ AG6AQ CM97"
      }
    },
    {
      "comment": "Period 11 (odd): DX's 73 closes the parked entry.",
      "messages": [
        {
          "call_to": "${MY_CALLSIGN}",
          "call_from": "${DX_CALLSIGN}",
          "locator": "73",
          "snr": -12,
          "slot": 1,
          "freq_hz": 1200
        }
      ],
      "expect": {
        "tx": ""
      }
    },
    {
      "comment": "Period 12 (even): CQ 3 of 5.",
      "messages": [],
      "expect": {
        "tx": "CQ AG6AQ CM97"
      }
    },
    {
      "comment": "Period 13 (odd)",
      "messages": [],
      "expect": {
        "tx": ""
      }
    },
    {
      "comment": "Period 14 (even): CQ 4 of 5.",
      "messages": [],
      "expect": {
        "tx": "CQ AG6AQ CM97"
      }
    },
    {
      "comment": "Period 15 (odd)",
      "messages": [],
      "expect": {
        "tx": ""
      }
    },
    {
      "comment": "Period 16 (even): CQ 5 of 5: the CQ ends.",
      "messages": [],
      "expect": {
        "tx": "CQ AG6AQ CM97"
      }
    },
    {
      "comment": "Period 17 (odd)",
      "messages": [],
      "expect": {
        "tx": ""
      }
    },
    {
      "comment": "Period 18 (even): nothing: the CQ's tries are used.",
      "messages": [],
      "expect": {
        "tx": ""
      }
    }
  ]
}
