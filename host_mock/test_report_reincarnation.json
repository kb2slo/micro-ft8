{
  "config": {
    "MY_CALLSIGN": "AG6AQ",
    "MY_GRID": "CM97",
    "DX_CALLSIGN": "W6ABC",
    "DX_GRID": "CM88",
    "TX_ON_EVEN": true
  },
  "comment": "REPORT reincarnation: we CQ, DX answers with its grid, and our report goes unanswered until its retries run out (the first send plus 5). The entry parks with snr_tx=-5. DX's late R-08 then reactivates it, so RR73 goes out and the QSO logs rst_sent=-5. Popping the entry instead let the R-08 build a fresh one with snr_tx=-99, which logged the wrong report. The scenario runner transmits a QSO entry in every period; only the beacon CQ waits for its own parity.",
  "periods": [
    {
      "comment": "Period 0 (even): beacon CQ",
      "messages": [],
      "beacon_change": {
        "time_offset": 0.0,
        "beacon_on": 1
      },
      "expect": {
        "tx": "CQ AG6AQ CM97"
      }
    },
    {
      "comment": "Period 1 (odd): DX replies to our CQ with TX1 (grid). snr=-5 is what we measure of DX. We send TX2.",
      "messages": [
        {
          "call_to": "${MY_CALLSIGN}",
          "call_from": "${DX_CALLSIGN}",
          "locator": "${DX_GRID}",
          "snr": -5,
          "slot": 1,
          "freq_hz": 1200
        }
      ],
      "expect": {
        "tx": "W6ABC AG6AQ -5"
      }
    },
    {
      "comment": "Period 2: TX2 retry 1/5. DX doesn't respond (QRM/weak signal) from here on.",
      "messages": [],
      "expect": {
        "tx": "W6ABC AG6AQ -5"
      }
    },
    {
      "comment": "Period 3: TX2 retry 2/5",
      "messages": [],
      "expect": {
        "tx": "W6ABC AG6AQ -5"
      }
    },
    {
      "comment": "Period 4: TX2 retry 3/5",
      "messages": [],
      "expect": {
        "tx": "W6ABC AG6AQ -5"
      }
    },
    {
      "comment": "Period 5: TX2 retry 4/5",
      "messages": [],
      "expect": {
        "tx": "W6ABC AG6AQ -5"
      }
    },
    {
      "comment": "Period 6: TX2 retry 5/5. The tick after it parks the entry, keeping snr_tx=-5.",
      "messages": [],
      "expect": {
        "tx": "W6ABC AG6AQ -5"
      }
    },
    {
      "comment": "Period 7 (odd): parked; nothing to send",
      "messages": [],
      "expect": {
        "tx": ""
      }
    },
    {
      "comment": "Period 8 (even): beacon CQ",
      "messages": [],
      "expect": {
        "tx": "CQ AG6AQ CM97"
      }
    },
    {
      "comment": "Period 9 (odd): nothing to send",
      "messages": [],
      "expect": {
        "tx": ""
      }
    },
    {
      "comment": "Period 10 (even): beacon CQ",
      "messages": [],
      "expect": {
        "tx": "CQ AG6AQ CM97"
      }
    },
    {
      "comment": "Period 11 (odd): nothing to send",
      "messages": [],
      "expect": {
        "tx": ""
      }
    },
    {
      "comment": "Period 12 (even): beacon CQ",
      "messages": [],
      "expect": {
        "tx": "CQ AG6AQ CM97"
      }
    },
    {
      "comment": "Period 13 (odd): DX finally sends TX3 (R-08). It reactivates the parked entry: RR73, logged with rst_sent=-5.",
      "messages": [
        {
          "call_to": "${MY_CALLSIGN}",
          "call_from": "${DX_CALLSIGN}",
          "locator": "R-08",
          "snr": -8,
          "slot": 1,
          "freq_hz": 1200
        }
      ],
      "expect": {
        "tx": "W6ABC AG6AQ RR73",
        "log": "W6ABC CM88 rst_sent=-5 rst_rcvd=-8"
      }
    },
    {
      "comment": "Period 14 (even): RR73 went out once and logged, so the entry parked again. The beacon CQ resumes.",
