{
  "config": {
    "MY_CALLSIGN": "AG6AQ",
    "MY_GRID": "CM97",
    "DX_CALLSIGN": "W6ABC",
    "DX_GRID": "CM88",
    "TX_ON_EVEN": true,
    "CQ_TYPE": "FD",
    "FREE_TEXT": "1A SCV"
  },
  "periods": [
    {
      "comment": "Period 0 (even): idle",
      "messages": [],
      "expect": {
        "tx": ""
      }
    },
    {
      "comment": "Period 1 (odd): DX sends CQ FD — we touch to reply with our exchange",
      "messages": [
        {
          "call_to": "CQ FD",
          "call_from": "${DX_CALLSIGN}",
          "locator": "${DX_GRID}",
          "snr": -8,
          "slot": 1,
          "freq_hz": 1200
        }
      ],
      "touch_event": {
        "time_offset": 14.0,
        "message_index": 0
      },
      "expect": {
        "tx": "W6ABC AG6AQ 1A SCV"
      }
    },
    {
      "comment": "Period 2 (even): we send our exchange (TX2): in FD mode, as in WSJT-X, a reply opens with it, never a grid",
      "messages": [],
      "expect": {
        "tx": "W6ABC AG6AQ 1A SCV"
      }
    },
    {
      "comment": "Period 3 (odd): DX sends FD exchange (their TX2)",
      "messages": [
        {
          "call_to": "${MY_CALLSIGN}",
          "call_from": "${DX_CALLSIGN}",
          "locator": "2A ORG",
          "snr": -6,
          "slot": 1
        }
      ],
      "expect": {
        "tx": "W6ABC AG6AQ R 1A SCV"
      }
    },
    {
      "comment": "Period 4 (even): we send R + our FD exchange (TX3)",
      "messages": [],
      "expect": {
        "tx": "W6ABC AG6AQ R 1A SCV"
      }
    },
    {
      "comment": "Period 5 (odd): DX sends RR73 (TX4)",
      "messages": [
        {
          "call_to": "${MY_CALLSIGN}",
          "call_from": "${DX_CALLSIGN}",
          "locator": "RR73",
          "snr": 0,
          "slot": 1
        }
      ],
      "expect": {
        "tx": "W6ABC AG6AQ 73",
        "log": "W6ABC CM88 rst_sent=-8 rst_rcvd=-99",
        "cabrillo": "W6ABC exchange=2A ORG"
      }
    },
    {
      "comment": "Period 6 (even): we send 73 (TX5), QSO complete",
      "messages": [],
      "expect": {
        "tx": ""
      }
    }
  ]
}
