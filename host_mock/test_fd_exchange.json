{
  "config": {
    "MY_CALLSIGN": "AG6AQ",
    "MY_GRID": "CM97",
    "DX_CALLSIGN": "N6HAN",
    "DX_GRID": "CM87",
    "TX_ON_EVEN": true,
    "CQ_TYPE": "FD",
    "FREE_TEXT": "1A SCV"
  },
  "periods": [
    {
      "comment": "Period 0 (even): Call CQ — we CQ FD on even slots",
      "messages": [],
      "cq_call": {
        "time_offset": 1.0,
        "tries": 99
      },
      "expect": {
        "tx": "CQ FD AG6AQ CM97"
      }
    },
    {
      "comment": "Period 1 (odd): nothing — CQ FD sent in period 0",
      "messages": [],
      "expect": {
        "tx": ""
      }
    },
    {
      "comment": "Period 2 (even): no reply yet, the CQ goes again",
      "messages": [],
      "expect": {
        "tx": "CQ FD AG6AQ CM97"
      }
    },
    {
      "comment": "Period 3 (odd): DX replies with FD exchange (their TX2: '1B SCV')",
      "messages": [
        {
          "call_to": "${MY_CALLSIGN}",
          "call_from": "${DX_CALLSIGN}",
          "locator": "1B SCV",
          "snr": -5,
          "slot": 1
        }
      ],
      "expect": {
        "tx": "N6HAN AG6AQ R 1A SCV"
      }
    },
    {
      "comment": "Period 4 (even): we respond with R + our FD exchange (TX3) — state ROGER_REPORT",
      "messages": [],
      "expect": {
        "tx": "N6HAN AG6AQ R 1A SCV"
      }
    },
    {
      "comment": "Period 5 (odd): DX sends RR73 (TX4) — acknowledging our R+exchange",
      "messages": [
        {
          "call_to": "${MY_CALLSIGN}",
          "call_from": "${DX_CALLSIGN}",
          "locator": "RR73",
          "snr": -3,
          "slot": 1
        }
      ],
      "expect": {
        "tx": "N6HAN AG6AQ 73",
        "log": "N6HAN  rst_sent=-5 rst_rcvd=-99",
        "cabrillo": "N6HAN exchange=1B SCV"
      }
    },
    {
      "comment": "Period 6 (even): we send 73 (TX5) — QSO complete",
      "messages": [],
      "expect": {
        "tx": "CQ FD AG6AQ CM97"
      }
    }
  ]
}
