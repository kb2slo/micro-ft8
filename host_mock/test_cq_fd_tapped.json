{
  "config": {
    "MY_CALLSIGN": "AG6AQ",
    "MY_GRID": "CM97",
    "DX_CALLSIGN": "W6ABC",
    "DX_GRID": "CM88",
    "TX_ON_EVEN": true
  },
  "periods": [
    {
      "comment": "Period 0 (even): idle. There is no Field Day operation: a tapped CQ FD gets an ordinary reply, and an exchange sent to us is ignored",
      "messages": [],
      "expect": {
        "tx": ""
      }
    },
    {
      "comment": "Period 1 (odd): DX sends CQ FD — we touch it: an ordinary reply with our grid, as WSJT-X sends outside Field Day mode",
      "messages": [
        {
          "call_to": "CQ FD",
          "call_from": "${DX_CALLSIGN}",
          "locator": "${DX_GRID}",
          "snr": -8,
          "slot": 1,
          "freq_hz": 1200
        }
      ],
      "touch_event": {
        "time_offset": 14.0,
        "message_index": 0
      },
      "expect": {
        "tx": "W6ABC AG6AQ CM97"
      }
    },
    {
      "comment": "Period 2 (even): we send TX1 (grid)",
      "messages": [],
      "expect": {
        "tx": "W6ABC AG6AQ CM97"
      }
    },
    {
      "comment": "Period 3 (odd): DX, in Field Day mode, answers with its exchange, which is not a message we sequence: ignored, and our grid goes again",
      "messages": [
        {
          "call_to": "${MY_CALLSIGN}",
          "call_from": "${DX_CALLSIGN}",
          "locator": "2A ORG",
          "snr": -6,
          "slot": 1
        }
      ],
      "expect": {
        "tx": "W6ABC AG6AQ CM97"
      }
    },
    {
      "comment": "Period 4 (even): our grid again, under the entry's tries",
      "messages": [],
      "expect": {
        "tx": "W6ABC AG6AQ CM97"
      }
    }
  ]
}
