{
  "config": {
    "MY_CALLSIGN": "AG6AQ",
    "MY_GRID": "CM97",
    "DX_CALLSIGN": "N6HAN",
    "DX_GRID": "CM87",
    "TX_ON_EVEN": true,
    "CQ_TYPE": "FD",
    "FREE_TEXT": "1B SCV"
  },
  "periods": [
    {
      "comment": "Period 0 (even): idle",
      "messages": [],
      "expect": {
        "tx": ""
      }
    },
    {
      "comment": "Period 1 (odd): DX sends CQ FD — we touch to reply",
      "messages": [
        {
          "call_to": "CQ FD",
          "call_from": "${DX_CALLSIGN}",
          "locator": "${DX_GRID}",
          "snr": -8,
          "slot": 1,
          "freq_hz": 1200
        }
      ],
      "touch_event": {
        "time_offset": 14.0,
        "message_index": 0
      },
      "expect": {
        "tx": "N6HAN AG6AQ CM97"
      }
    },
    {
      "comment": "Period 2 (even): we send TX2 (exchange) to DX",
      "messages": [],
      "expect": {
        "tx": "N6HAN AG6AQ CM97"
      }
    },
    {
      "comment": "Period 3 (odd): DX sends R + FD exchange (TX3). We send RR73, and the QSO logs here (ADIF and Cabrillo).",
      "messages": [
        {
          "call_to": "${MY_CALLSIGN}",
          "call_from": "${DX_CALLSIGN}",
          "locator": "R 1A SCV",
          "snr": -6,
          "slot": 1
        }
      ],
      "expect": {
        "tx": "N6HAN AG6AQ RR73",
        "log": "N6HAN CM87 rst_sent=-8 rst_rcvd=-99",
        "cabrillo": "N6HAN exchange=1A SCV"
      }
    },
    {
      "comment": "Period 4 (even): no resend. RR73 went out once, logged, so the entry parked.",
      "messages": [],
      "expect": {
        "tx": ""
      }
    },
    {
      "comment": "Period 5 (odd): DX sends RR73 back. It reactivates the parked entry, and ROGERS + RR73 → IDLE: no TX, no second log.",
      "messages": [
        {
          "call_to": "${MY_CALLSIGN}",
          "call_from": "${DX_CALLSIGN}",
          "locator": "RR73",
          "snr": 0,
          "slot": 1
        }
      ],
      "expect": {
        "tx": ""
      }
    },
    {
      "comment": "Period 6 (even): nothing queued, no double log",
      "messages": [],
      "expect": {
        "tx": ""
      }
    },
    {
      "comment": "Period 7 (odd): DX sends RR73 yet again (late). No entry holds the call now, so the late signoff is ignored.",
      "messages": [
        {
          "call_to": "${MY_CALLSIGN}",
          "call_from": "${DX_CALLSIGN}",
          "locator": "RR73",
          "snr": 0,
          "slot": 1
        }
      ],
      "expect": {
        "tx": ""
      }
    },
    {
      "comment": "Period 8 (even): verify no TX, no extra logging",
      "messages": [],
      "expect": {
        "tx": ""
      }
    }
  ]
}
