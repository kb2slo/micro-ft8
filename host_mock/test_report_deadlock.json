{
  "config": {
    "MY_CALLSIGN": "AG6AQ",
    "MY_GRID": "CM97",
    "DX_CALLSIGN": "N6HAN",
    "DX_GRID": "CM87",
    "TX_ON_EVEN": true
  },
  "periods": [
    {
      "comment": "Period 0 (even): Call CQ — we will CQ on even slots",
      "messages": [],
      "cq_call": {
        "time_offset": 1.0,
        "tries": 99
      },
      "expect": {
        "tx": "CQ AG6AQ CM97"
      }
    },
    {
      "comment": "Period 1 (odd): nothing — our CQ was sent in period 0",
      "messages": [],
      "expect": {
        "tx": ""
      }
    },
    {
      "comment": "Period 2 (even): no RX yet, the CQ goes again",
      "messages": [],
      "expect": {
        "tx": "CQ AG6AQ CM97"
      }
    },
    {
      "comment": "Period 3 (odd): DX sends TX1 (grid) in response to our CQ",
      "messages": [
        {
          "call_to": "${MY_CALLSIGN}",
          "call_from": "${DX_CALLSIGN}",
          "locator": "${DX_GRID}",
          "snr": -10,
          "slot": 1
        }
      ],
      "expect": {
        "tx": "N6HAN AG6AQ -10"
      }
    },
    {
      "comment": "Period 4 (even): we send TX2 (report).  Autoseq should be in REPORT.",
      "messages": [],
      "expect": {
        "tx": "N6HAN AG6AQ -10"
      }
    },
    {
      "comment": "Period 5 (odd): DX sends TX2 (report WITHOUT R prefix) — BUG trigger",
      "messages": [
        {
          "call_to": "${MY_CALLSIGN}",
          "call_from": "${DX_CALLSIGN}",
          "locator": "-07",
          "snr": -7,
          "slot": 1
        }
      ],
      "expect": {
        "tx": "N6HAN AG6AQ R-10"
      }
    },
    {
      "comment": "Period 6 (even): we send TX3 (R+report). FIX: should be ROGER_REPORT.",
      "messages": [],
      "expect": {
        "tx": "N6HAN AG6AQ R-10"
      }
    },
    {
      "comment": "Period 7 (odd): DX sends TX4 (RR73)",
      "messages": [
        {
          "call_to": "${MY_CALLSIGN}",
          "call_from": "${DX_CALLSIGN}",
          "locator": "RR73",
          "snr": 0,
          "slot": 1
        }
      ],
      "expect": {
        "tx": "N6HAN AG6AQ 73",
        "log": "N6HAN CM87 rst_sent=-10 rst_rcvd=-7"
      }
    },
    {
      "comment": "Period 8 (even): we send TX5 (73), QSO complete",
      "messages": [],
      "expect": {
        "tx": "CQ AG6AQ CM97"
      }
    }
  ]
}
