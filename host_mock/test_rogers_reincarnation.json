  "comment": "ROGERS reincarnation: the QSO completes and logs at our first RR73, and the entry parks right after it (ROGERS sends RR73 once). Three minutes later DX resends R-08, having missed our RR73. It must reactivate the parked entry: RR73 again and no second log. If the entry were gone, on_decode() would refuse an R-report from an unknown call and send nothing, so period 15 would fail. The scenario runner transmits a QSO entry in every period; only the CQ waits for its own parity.",
  "periods": [
    {
      "comment": "Period 0 (even): CQ",
      "messages": [],
      "cq_call": {
        "time_offset": 0.0,
        "tries": 99
      },
      "expect": {
        "tx": "CQ AG6AQ CM97"
      }
    },
    {
      "comment": "Period 1 (odd): DX replies with TX1 (grid)",
      "messages": [
        {
          "call_to": "${MY_CALLSIGN}",
          "call_from": "${DX_CALLSIGN}",
          "locator": "${DX_GRID}",
          "snr": -5,
          "slot": 1,
          "freq_hz": 1200
        }
      ],
      "expect": {
        "tx": "W6ABC AG6AQ -5"
      }
    },
    {
      "comment": "Period 2 (even): We send TX2 (report: -5)",
      "messages": [],
      "expect": {
        "tx": "W6ABC AG6AQ -5"
      }
    },
    {
      "comment": "Period 3 (odd): DX sends TX3 (R-08), acknowledging our report. REPORT+TX3 → ROGERS: RR73, and the QSO logs with rst_sent=-5, rst_rcvd=-8. The tick after it parks the entry.",
      "messages": [
        {
          "call_to": "${MY_CALLSIGN}",
          "call_from": "${DX_CALLSIGN}",
          "locator": "R-08",
          "snr": -8,
          "slot": 1,
          "freq_hz": 1200
        }
      ],
      "expect": {
        "tx": "W6ABC AG6AQ RR73",
        "log": "W6ABC CM88 rst_sent=-5 rst_rcvd=-8"
      }
    },
    {
      "comment": "Period 4 (even): no RR73 resend; the CQ resumes.",
      "messages": [],
      "expect": {
        "tx": "CQ AG6AQ CM97"
      }
    },
