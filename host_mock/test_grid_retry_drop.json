{
  "comment": "A touch that only exchanges grids is dropped when its tries run out, not parked. A later R+report must not revive it, and a later report starts a new QSO at the new SNR, which logs the grid heard in the tapped CQ.",
  "config": {
    "MY_CALLSIGN": "AG6AQ",
    "MY_GRID": "CM97",
    "DX_CALLSIGN": "N6HAN",
    "DX_GRID": "CM87",
    "TX_ON_EVEN": true,
    "TRIES": 2
  },
  "periods": [
    {
      "comment": "Period 0 (even): Call CQ",
      "messages": [],
      "cq_call": {
        "time_offset": 1.0,
        "tries": 99
      },
      "expect": {
        "tx": "CQ AG6AQ CM97"
      }
    },
    {
      "comment": "Period 1 (odd): touch their CQ. First grid. 2 tries.",
      "messages": [
        {
          "call_to": "CQ",
          "call_from": "${DX_CALLSIGN}",
          "locator": "${DX_GRID}",
          "snr": -5,
          "slot": 1,
          "freq_hz": 1200
        }
      ],
      "touch_event": {
        "time_offset": 14.0,
        "message_index": 0
      },
      "expect": {
        "tx": "N6HAN AG6AQ CM97"
      }
    },
    {
      "comment": "Period 2 (even): the second try, then the entry is dropped",
      "messages": [],
      "expect": {
        "tx": "N6HAN AG6AQ CM97"
      }
    },
    {
      "comment": "Period 3 (odd): their R+report has nothing to revive",
      "messages": [
        {
          "call_to": "${MY_CALLSIGN}",
          "call_from": "${DX_CALLSIGN}",
          "locator": "R-5",
          "snr": -5,
          "slot": 1
        }
      ],
      "expect": {
        "tx": ""
      }
    },
    {
      "comment": "Period 4 (even): the CQ is back. The dropped QSO is not blocking it.",
      "messages": [],
      "expect": {
        "tx": "CQ AG6AQ CM97"
      }
    },
    {
      "comment": "Period 5 (odd): a fresh report starts a new QSO at -18, not the old -5",
      "messages": [
        {
          "call_to": "${MY_CALLSIGN}",
          "call_from": "${DX_CALLSIGN}",
          "locator": "-18",
          "snr": -18,
          "slot": 1
        }
      ],
      "expect": {
        "tx": "N6HAN AG6AQ R-18"
      }
    },
    {
      "comment": "Period 6 (even): resend",
      "messages": [],
      "expect": {
        "tx": "N6HAN AG6AQ R-18"
      }
    },
    {
      "comment": "Period 7 (odd): RR73. Log the new SNR, and the grid N6HAN sent in its CQ (the heard-grid table), though the entry that held it was dropped.",
      "messages": [
        {
          "call_to": "${MY_CALLSIGN}",
          "call_from": "${DX_CALLSIGN}",
          "locator": "RR73",
          "snr": 0,
          "slot": 1
        }
      ],
      "expect": {
        "tx": "N6HAN AG6AQ 73",
        "log": "N6HAN CM87 rst_sent=-18 rst_rcvd=-18"
      }
    }
  ]
}
