#!/usr/bin/env bash
# Runs tools/check.sh --changed before anything leaves this machine (AGENTS.md, Never report a
# field check as passed). Enabled once per clone: git config core.hooksPath .githooks
# (CONTRIBUTING.md, Setup). Bypassed only with git push --no-verify, which needs the person you
# work for to say so in so many words.
#
# The checks read the working tree, so the push is refused when that is not what is being pushed:
# tracked files with uncommitted changes, or a pushed commit other than this checkout's HEAD.
set -u

head="$(git rev-parse HEAD)"
zero="0000000000000000000000000000000000000000"
pushing=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue  # deleting a remote ref: nothing to check
  if [ "$local_sha" != "$head" ]; then
    echo "pre-push: pushing $local_ref ($local_sha), but the checks test this checkout's HEAD ($head)."
    echo "pre-push: check out what you are pushing, then push again."
    exit 1
  fi
  pushing=1
done
[ "$pushing" = 1 ] || exit 0

if ! git diff --quiet HEAD --; then
  echo "pre-push: tracked files have uncommitted changes, so the checks would test something other"
  echo "pre-push: than the commits being pushed. Commit or stash them, then push again."
  git diff --stat HEAD -- | tail -5
  exit 1
fi

# Git exports GIT_DIR (and friends) to hooks, and it beats `git -C <dir>`: a check that drives another
# repository, such as decode_recall's corpus clone, would act on this one instead. The checks find their
# repositories from the working directory, as when run by hand.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_PREFIX GIT_COMMON_DIR

echo "pre-push: tools/check.sh --changed"
if ! tools/check.sh --changed; then
  echo "pre-push: checks failed; nothing was pushed."
  exit 1
fi
