# Build artifacts
.cache
/build/
*.bin
*.elf
*.map
idf_py_*
main/*.o
# host_mock compiles some components/ sources in place too (autoseq, adif) --
# same stray-.o pattern main/*.o above already covers, now in two more spots
# since the P4 port moved those files out of main/ into components/.
components/autoseq/*.o
components/adif/*.o

# ESP-IDF managed components (auto-fetched by idf.py build)
/managed_components/

# IDE / editor
.vscode/
.idea/
*.swp
*.swo

# Python
__pycache__/
*.pyc

# Logs
*.log

!release/*.bin

# macOS
.DS_Store


# Test build outputs (Windows MSVC / CMake)
tests/tx_e2e/build/
tests/tx_e2e/build_vs/
tests/tx_e2e/build_new/
tests/tx_e2e/build_host/
tests/tx_e2e/build_mingw/
tests/tx_e2e/*.exe
tests/tx_e2e/*.ilk
tests/tx_e2e/*.pdb
tests/tx_e2e/*.lib
tests/tx_e2e/Makefile
tests/tx_e2e/cmake_install.cmake
tests/tx_e2e/CTestTestfile.cmake
tests/tx_e2e/Testing/
Testing/

# Scratch diff/patch files
*.diff
*.patch

# sidekick: separate idf.py project (docs/architecture/sidekick.md (Installing the sidekick from the ADV))
sidekick/build/
sidekick/managed_components/
sidekick/sdkconfig

# test_apps/atoms3_qmx_host_poc: separate idf.py project (docs/architecture/system.md (Why not) evidence)
test_apps/atoms3_qmx_host_poc/build/
test_apps/atoms3_qmx_host_poc/managed_components/
test_apps/atoms3_qmx_host_poc/sdkconfig
test_apps/atoms3_qmx_host_poc/dependencies.lock
sidekick/sdkconfig.old

# poe_p4: separate idf.py project, ESP32-P4 (docs/STYLE.md (Two boards, one source))
poe_p4/build/
poe_p4/managed_components/
poe_p4/sdkconfig
poe_p4/sdkconfig.old

# Per-device full-flash backups of a physical Nano's factory state
# (tools/restore_nano_stock.sh). Vendor firmware (M5Stack), not ours to
# redistribute, and a snapshot of one specific unit besides — already caught
# by the blanket *.bin rule above, called out explicitly so the exclusion is
# a decision, not an accident.
sidekick/stock_backup/

# Cached sidekick pairing token (webapp/tools/sidekick.py) -- a live
# credential that guards transmit control on a licensed radio, scoped to one
# physical device. Never belongs in source control.
webapp/tools/.sidekick_token

# Wrangler installs itself here at deploy time (.github/workflows/pages.yml);
# webapp/.assetsignore keeps it out of the deployed site, this keeps it out
# of git.
webapp/node_modules/
webapp/.wrangler/
