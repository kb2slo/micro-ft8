# AtomS3 Lite is an ESP32-S3FN8: 8 MB flash, no PSRAM. Without this the build
# takes ESP-IDF's 2 MB default, which understates the part and writes a wrong
# flash-size field into the bootloader header. Pinned in-repo (sdkconfig itself
# is gitignored and regenerated) so a fresh clone configures the same way.
#
# Bootloader 0x0, partition table 0x8000, app in ota_0 at 0x20000, so the
# sidekick's esp_app_desc_t is at absolute 0x20020 (sidekick/README.md,
# Version identity).
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y

# Two OTA slots (partitions.csv) — docs/architecture/sidekick.md (Firmware updates). No factory partition: with
# otadata erased the bootloader boots ota_0.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# Roll back automatically if a new image never confirms itself. The app marks
# itself valid only once it has sent its Port A beacons and is back on the
# network, and restarts if it is not within five minutes (fw_policy.h,
# fw_confirm_decide()), so an update that boots but cannot be reached reverts
# on its own rather than needing a cable.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# Firmware images are fetched over plain HTTP and checked against a SHA-256
# (docs/architecture/sidekick.md, Why the sidekick has no TLS), so ESP-IDF's
# HTTP client is built to refuse an https:// URL. Its TLS library is still
# linked; nothing calls it.
CONFIG_ESP_HTTP_CLIENT_ENABLE_HTTPS=n

# IDF default (10) is a global ceiling shared by every socket in the system --
# httpd, mDNS, station/AP netif. httpd alone wants a real client budget (see
# max_open_sockets in wifi_prov.c), so raised with headroom left over for the
# rest. Picked blind, without an on-device heap reading -- TEST_PLAN.md
# Pending.
CONFIG_LWIP_MAX_SOCKETS=16

# What a connection may have sent and not yet had acknowledged: 2 MSS, not IDF's 4. lwIP keeps those bytes
# until the client acknowledges them, closed connections included, so the worst case is every TCP slot full:
# 16 x 5760 is 92 KB, more than the ~87 KB the sidekick has free, and a WiFi stall overnight took the heap to
# 392 bytes (2026-11-18; docs/architecture/sidekick.md, Tasks and cores). 16 x 2880 is 46 KB. A send to one client goes at half the bytes
# in flight per round trip: a page reload's median went from 343 to 472 ms on the bench's WiFi (2026-11-18).
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=2880

# The web server's queue of work for its own task (httpd_queue_work(), and every async request handed back) is
# its control socket's UDP mailbox: IDF's 6 places. With the sender pool, requests come back from four tasks at
# once during a page load and filled it, so the server could not queue closing an idle connection and refused
# a new one instead (`ctrl socket queue full`, `error accepting new connection`, 2026-11-18, six pages on the
# AP). 16 places cost a few dozen bytes for each of the sidekick's few UDP sockets.
CONFIG_LWIP_UDP_RECVMBOX_SIZE=16

# Port A. A WiFi flash access otherwise stalls the UART interrupt longer than
# the 128-byte FIFO.
CONFIG_UART_ISR_IN_IRAM=y

# The AP lease offers no DNS server (wifi_prov.c, ap_lease_local_only()). On,
# IDF's DHCP server adds its own address as DNS whatever the code asks.
CONFIG_LWIP_DHCPS_ADD_DNS=n
