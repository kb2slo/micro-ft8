# AtomS3 Lite is an ESP32-S3FN8: 8 MB flash, no PSRAM. Without this the build
# takes ESP-IDF's 2 MB default, which understates the part and writes a wrong
# flash-size field into the bootloader header. Pinned in-repo (sdkconfig itself
# is gitignored and regenerated) so a fresh clone configures the same way.
#
# Bootloader 0x0, partition table 0x8000, app in ota_0 at 0x20000, so the
# sidekick's esp_app_desc_t is at absolute 0x20020 (sidekick/README.md,
# Version identity).
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y

# Two OTA slots (partitions.csv) — docs/architecture/sidekick.md (Firmware updates). No factory partition: with
# otadata erased the bootloader boots ota_0.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# Roll back automatically if a new image never confirms itself. The app marks
# itself valid only once the PORTA beacon is confirmed working, so an update
# that boots but cannot talk reverts on its own rather than needing a cable.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# IDF default (10) is a global ceiling shared by every socket in the system --
# httpd, mDNS, station/AP netif. httpd alone wants a real client budget (see
# max_open_sockets in wifi_prov.c), so raised with headroom left over for the
# rest. Picked blind, without an on-device heap reading -- TEST_PLAN.md
# Pending.
CONFIG_LWIP_MAX_SOCKETS=16

# Port A. A WiFi flash access otherwise stalls the UART interrupt longer than
# the 128-byte FIFO.
CONFIG_UART_ISR_IN_IRAM=y
