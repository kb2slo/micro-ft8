{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "micro-ft8",
  "compatibility_date": "2026-09-15",
  "main": "worker.js",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    // Default: Cloudflare serves a matching static file directly, bypassing
    // worker.js entirely, which is exactly why the CORS header never showed
    // up on manifest.json or on the app.html clean-URL redirect -- only
    // requests with no matching asset (e.g. a genuine 404) ever reached our
    // fetch handler. This forces every request through worker.js first.
    "run_worker_first": true
  },
  "routes": [
    {
      "pattern": "micro-ft8.kalikstein.com",
      "custom_domain": true
    }
  ]
}
