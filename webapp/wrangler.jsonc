{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "micro-ft8",
  "compatibility_date": "2026-09-15",
  "main": "worker.js",
  "assets": {
    "directory": ".",
    // Only these two run worker.js; every other request is served as a static
    // file, with its headers from _headers (docs/architecture/webapp.md,
    // Serving the site), and costs no Worker request.
    "run_worker_first": ["/download/*", "/pskreporter"]
  },
  "r2_buckets": [
    {
      "binding": "DOWNLOADS",
      "bucket_name": "micro-ft8-downloads"
    }
  ],
  "routes": [
    {
      "pattern": "micro-ft8.kalikstein.com",
      "custom_domain": true
    }
  ]
}
