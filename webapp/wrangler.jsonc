{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "micro-ft8",
  "compatibility_date": "2026-09-15",
  "main": "worker.js",
  "assets": {
    "directory": ".",
    // Only these run worker.js; every other request is served as a static
    // file, with its headers from _headers (docs/architecture/webapp.md,
    // Serving the site), and costs no Worker request.
    "run_worker_first": ["/download/*", "/qrz/*", "/pskr/*"],
    // A path with no file gets 404.html, status 404, still without the Worker.
    "not_found_handling": "404-page"
  },
  "r2_buckets": [
    {
      "binding": "DOWNLOADS",
      "bucket_name": "micro-ft8-downloads"
    }
  ],
  // One data point per file /download/ serves (worker.js, countDownload()):
  // docs/architecture/webapp.md, Download counts.
  "analytics_engine_datasets": [
    {
      "binding": "DOWNLOAD_COUNTS",
      "dataset": "micro_ft8_downloads"
    },
    // One data point per post /pskr/report takes (worker.js, countPskr()):
    // docs/architecture/system.md, Third-party services.
    {
      "binding": "PSKR_REPORTS",
      "dataset": "micro_ft8_pskr_reports"
    }
  ],
  // One gate per receiving station, deciding what of its pages' reports go to
  // PSKReporter (pskr_report.js, PskrGate). SQLite-backed, the kind the free
  // plan has.
  "durable_objects": {
    "bindings": [
      {
        "name": "PSKR_GATE",
        "class_name": "PskrGate"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["PskrGate"]
    }
  ],
  "routes": [
    {
      "pattern": "micro-ft8.kalikstein.com",
      "custom_domain": true
    }
  ]
}
