{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "micro-ft8",
  "compatibility_date": "2026-09-15",
  "main": "worker.js",
  "assets": {
    "directory": ".",
    "binding": "ASSETS"
  },
  "routes": [
    {
      "pattern": "micro-ft8.kalikstein.com",
      "custom_domain": true
    }
  ]
}
