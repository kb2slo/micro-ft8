# Wrangler's own tooling installs itself here at deploy time (workingDirectory:
# webapp in .github/workflows/pages.yml) -- none of this is site content.
node_modules
# The build's output (webapp/tools/build.py); pages.yml moves the built bundle
# into app/ before deploying, so dist/ never ships on its own.
dist
wrangler.jsonc
worker.js
.assetsignore
.wrangler
