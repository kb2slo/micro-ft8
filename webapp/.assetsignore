# Wrangler's own tooling installs itself here at deploy time (workingDirectory:
# webapp in .github/workflows/pages.yml) -- none of this is site content.
node_modules
# The web app's sources and the build's output (webapp/tools/build.py): the app ships in the
# sidekick's image, not on the site (docs/architecture/sidekick.md, Web root).
app
dist
wrangler.jsonc
worker.js
pskr_report.js
.assetsignore
.wrangler
# Build scripts and their tests run before the deploy; no page loads them.
tools
tests
# The getting-started page's source; pages.yml deploys the page built from it.
getting-started.md
