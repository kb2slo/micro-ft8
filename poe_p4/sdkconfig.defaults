# M5Stack Unit PoE-P4 (SKU U213): 16 MB flash, 32 MB octal PSRAM
# (docs.m5stack.com/en/unit/Unit_PoE-P4, checked directly -- docs/architecture/main_board.md (P4 (M5Stack Unit PoE-P4, U213))).
# Without this the build takes ESP-IDF's default flash size and writes a
# wrong flash-size field into the bootloader header, same reasoning as
# sidekick/sdkconfig.defaults.
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

# PSRAM is deliberately not enabled yet. Phase 0 is a boot-only skeleton with
# no code that uses it; enabling it blind, before anything exercises it, is
# exactly the kind of unverified config this project's docs warn against.
# Revisit when Phase 2 (decode/TX port) actually needs it.

# Field-found 2026-09-17, ESP-IDF v5.5.5: <v3.0 and >=v3.0 ESP32-P4 silicon are
# a hard Kconfig branch (esp_hw_support/port/esp32p4/Kconfig.hw_support --
# "huge hardware difference... not compatible"), and the default is the >=v3.0
# branch (CONFIG_ESP32P4_REV_MIN_301). The real U213 board is v1.3 silicon
# (confirmed via esptool's own "Chip is ESP32-P4 (revision v1.3)" on connect),
# so the default flashed a bootloader that refused to boot on it
# ("requires chip revision in range [v3.1 - v3.99]"). REV_MIN_100 (v1.0) is
# the least-restrictive choice that still excludes v0.x pre-production
# revisions this board has never been confirmed on.
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y
CONFIG_ESP32P4_REV_MIN_100=y

# Bench-found 2026-09-17 (B59): the IDF default (256 B) is too small for the
# config descriptor of an ordinary USB device (flash drive), which fails
# enumeration with "Configuration descriptor larger than control transfer
# max length" -- the console kept running through the error, so this is not
# a two-port/power problem, just an undersized default. Carried over from
# the ADV's own sdkconfig, which already proved 2048 works for a QMX (a much
# larger composite descriptor than a plain flash drive) rather than guessing
# a smaller number blind.
CONFIG_USB_HOST_CONTROL_TRANSFER_MAX_SIZE=2048

# Bench-found 2026-09-18 (B67): IDF default main stack (3584) overflows on
# CONFIG_GET — porta handle_config_get keeps a 2 KiB snapshot buffer plus a
# frame, and snprintf hits the stack canary ("Stack protection fault" in
# _svfprintf_r / main). ADV already runs 16384 for the same porta pump;
# match that so phone Settings load does not reboot the P4.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384

# I29: custom table with LittleFS `storage` partition (Station.txt).
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
